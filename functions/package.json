{
  "name": "safeher-functions",
  "version": "1.0.0",
  "description": "SafeHer Phase 7B 2nd Generation Cloud Functions Backend",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "npm run test:functions",
    "test:functions": "mocha -r ts-node/register test/functions.test.ts --timeout 10000",
    "test:rules": "mocha -r ts-node/register test/rules.test.ts --timeout 20000"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/chai": "^4.3.14",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "chai": "^4.4.1",
    "firebase-functions-test": "^3.2.0",
    "mocha": "^10.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  },
  "private": true
}
