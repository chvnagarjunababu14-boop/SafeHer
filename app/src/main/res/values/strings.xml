    <!-- Onboarding Slide 1: Personal Safety -->
    <string name="onboarding_slide1_title">Personal Safety &amp; Circle</string>
    <string name="onboarding_slide1_subtitle">Your safety circle, your way</string>
    <string name="onboarding_slide1_desc">Configure your inner circle of trusted family and friends. When you need help, SafeHer lets you alert your guardians instantly without confusing menus or delay.</string>
    <string name="onboarding_slide1_badge">Trusted Circle</string>

    <!-- Onboarding Slide 2: Journey Safety -->
    <string name="onboarding_slide2_title">Journey Safety &amp; Check-ins</string>
    <string name="onboarding_slide2_subtitle">Local ETA monitoring you control</string>
    <string name="onboarding_slide2_desc">Set a destination and estimated arrival time before heading out. SafeHer monitors your journey locally and notifies you to confirm you are safe if your arrival is delayed.</string>
    <string name="onboarding_slide2_badge">Local Monitoring</string>

    <!-- Onboarding Slide 3: SOS Protection -->
    <string name="onboarding_slide3_title">Deliberate SOS Protection</string>
    <string name="onboarding_slide3_subtitle">Fast emergency signaling</string>
    <string name="onboarding_slide3_desc">Hold the SOS button for 2 seconds to dispatch emergency signals. Send direct SMS alerts with live coordinates to your guardians, with automatic or manual fallback. Sending an SMS does not guarantee delivery due to carrier networks.</string>
    <string name="onboarding_slide3_badge">Direct &amp; Manual SOS</string>

    <!-- Onboarding Slide 4: Privacy & Control -->
    <string name="onboarding_slide4_title">Privacy &amp; On-Device Control</string>
    <string name="onboarding_slide4_subtitle">Zero continuous tracking</string>
    <string name="onboarding_slide4_desc">Your contacts, journey logs, and coordinates stay on your device. SafeHer only accesses location in the foreground or during active journeys. No third-party data brokers, ever.</string>
    <string name="onboarding_slide4_badge">Privacy First</string>

